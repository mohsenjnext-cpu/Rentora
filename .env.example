# Rentora Testnet server configuration
NODE_ENV=production
PORT=3000

# Pi Testnet API
PI_API_URL=https://api.minepi.com/v2
PI_API_KEY=replace_with_testnet_server_api_key
PI_NETWORK=testnet

# Public HTTPS origin(s) allowed to call the API. No wildcard in production.
CORS_ORIGIN=https://your-rentora-app.example
APP_URL=https://your-rentora-app.example

# Authoritative persistence. Do not use local JSON/files in production.
DATABASE_URL=postgresql://user:password@host:5432/rentora

# Cryptographically random server secret, at least 32 bytes.
SESSION_SECRET=replace_with_a_long_random_secret

# Comma-separated Pi UIDs that are allowed to administer the platform.
# Do not put usernames here because usernames are not a security boundary.
ADMIN_PI_UIDS=

# Frontend build-time API endpoint.
# This is public configuration, never a secret.
VITE_API_BASE_URL=https://your-rentora-api.example
