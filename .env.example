# Rentora Pi Testnet / Cloudflare Worker configuration
NODE_ENV=production

# Pi Testnet API
PI_API_URL=https://api.minepi.com/v2
PI_NETWORK=testnet

# Public frontend origin. Never use * in production.
CORS_ORIGIN=https://your-rentora-app.example
APP_URL=https://your-rentora-app.example

# Platform fee as a decimal. 0.05 = 5%.
PLATFORM_FEE_RATE=0.05

# Comma-separated Pi UIDs allowed to administer Rentora.
# Use UIDs, never usernames, as the security boundary.
ADMIN_PI_UIDS=

# Cloudflare bindings are configured on the Worker, not here:
# RENTORA_DB = D1 binding
# RENTORA_KV = KV binding

# Secrets are configured with Cloudflare secrets. Never commit them:
# PI_API_KEY

# Frontend build-time API endpoint. Public configuration, not a secret.
VITE_API_BASE_URL=https://your-rentora-api.example
