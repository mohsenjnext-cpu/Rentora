# =============================================================================
# RENTORA P2P MARKETPLACE - ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Pi Network Platform API Endpoint
# Default Mainnet / Testnet API: https://api.minepi.com/v2
PI_API_URL=https://api.minepi.com/v2

# Pi Network Server API Key (Obtain from https://develop.pi -> API Keys)
# DO NOT EXPOSE THIS KEY IN CLIENT CODE OR VERSION CONTROL
PI_API_KEY=your_pi_server_api_key_here

# App Domain URL (e.g. https://rentora.app)
APP_URL=https://your-domain.com
